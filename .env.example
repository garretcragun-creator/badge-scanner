# HubSpot OAuth App credentials
HUBSPOT_CLIENT_ID=your-client-id
HUBSPOT_CLIENT_SECRET=your-client-secret

# Your Railway public URL (no trailing slash)
BASE_URL=https://your-app.up.railway.app

# Anthropic API key (for server-side badge OCR)
ANTHROPIC_API_KEY=sk-ant-your-key

# HubSpot meeting link — fallback if event doesn't have its own
# (e.g. https://meetings.hubspot.com/your-name)
MEETING_LINK=https://meetings.hubspot.com/your-link

# Port (Railway sets this automatically)
PORT=3000
